  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "nastya": {
              "password": "initial",
              "roles": [
                "support"
              ]
            },
            "dzianis": {
              "password": "initial",
              "roles": [
                "support"
              ]
            },
            "tesla": {
              "password": "initial",
              "roles": [
                "support"
              ]
            }
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": {
          "destination": "API_BUSINESS_PARTNER"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      }
    },
    "sql": {
      "native_hana_associations": false
    }
